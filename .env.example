# ==========================================
# Finance-RAG 环境变量模板
# 用法: cp .env.example .env 然后填入真实值
# ==========================================

# 1. 大模型 API 密钥 (阿里云百炼)
#    申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY="sk-请替换为你的API_KEY"

# 2. 后端服务配置
DEBUG="false"
API_HOST="0.0.0.0"
API_PORT="8000"
API_SECRET_KEY="请生成一个32位随机字符串替换此处"
# 跨域白名单（开发用 localhost，部署改为服务器域名，逗号分隔）
CORS_ORIGINS="http://localhost:5173,http://localhost:8502"

# 3. 模型配置 (可选，默认值即可用)
# LLM_MODEL="qwen-max"
# EMBEDDING_MODEL="text-embedding-v4"
# RERANK_MODEL="gte-rerank-v2"

# 4. Milvus 向量库 — Docker 模式用容器名，本地调试用 127.0.0.1
MILVUS_HOST="milvus-standalone-v2"
MILVUS_PORT="19530"
COLLECTION_NAME="finance_reports_v3"

# 5. PostgreSQL — Docker 模式用容器名，本地调试用 127.0.0.1
PG_HOST="finance-rag-postgres-v2"
PG_PORT="5432"
PG_USER="rag_user"
PG_PASSWORD="rag_password"
PG_DB="rag_db"
